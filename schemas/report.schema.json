{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkl5pcrrq8gba.cloudfront.net/sales/schemas/report.schema.json",
  "title": "OREC daily sales intelligence report",
  "type": "object",
  "required": ["schemaVersion", "id", "publishedAt", "theme", "summary", "marketSignals", "repairInfo", "salesPlaybook", "makitaRelevance", "sources", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "theme": {
      "type": "object",
      "required": ["key", "label", "headline"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "headline": { "type": "string" }
      }
    },
    "summary": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
    "marketSignals": { "type": "array" },
    "repairInfo": { "type": "array" },
    "salesPlaybook": { "type": "object" },
    "makitaRelevance": { "type": ["object", "null"] },
    "sources": { "type": "array", "minItems": 1 },
    "warnings": { "type": "array" }
  },
  "additionalProperties": true
}
